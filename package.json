{
  "name": "schoolino",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Schoolino — a Persian-first online learning platform landing page (frontend demo).",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build --force && vite build",
    "build:only": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"tests/**/*.ts\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css,json}\" \"tests/**/*.ts\" \"docs/**/*.md\""
  },
  "dependencies": {
    "@fontsource-variable/estedad": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/vazirmatn": "5.3.0",
    "@iconify-json/lucide": "1.2.149",
    "@iconify/vue": "5.0.4",
    "@vueuse/core": "13.9.0",
    "@vueuse/motion": "3.0.3",
    "vue": "3.5.44",
    "vuetify": "3.13.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.18",
    "@types/node": "22.18.12",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/coverage-v8": "3.2.7",
    "@vue/test-utils": "2.5.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "sass": "1.94.1",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vite-plugin-vue-devtools": "8.2.1",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "3.2.7",
    "vue-tsc": "2.2.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
