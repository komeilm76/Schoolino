{
  "name": "schoolino-avin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/browser-check.mjs",
    "dev:inspect": "vite --host 0.0.0.0 --mode inspect",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.2.0",
    "@vueuse/core": "^13.0.0",
    "@vueuse/motion": "^3.0.3",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0",
    "vuetify": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.14.0",
    "bun": ">=1.3.0"
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
